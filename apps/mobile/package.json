{
  "name": "@offline-routing/mobile",
  "version": "0.1.0",
  "main": "index.js",
  "type": "module",
  "dependencies": {
    "@offline-routing/route-studio": "workspace:*",
    "@maplibre/maplibre-react-native": "^11.2.1",
    "expo": "~54.0.27",
    "expo-asset": "~12.0.12",
    "expo-file-system": "~19.0.21",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-nitro-modules": "0.32.1",
    "react-native-svg": "15.12.1",
    "react-native-offline-router": "workspace:*"
  },
  "publishConfig": {
    "executableFiles": [
      "./android/gradlew"
    ]
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas-build-pre-install": "bash ../../scripts/ios/eas-build-pre-install.sh",
    "build:ios-internal": "eas build --platform ios --profile ios-internal --non-interactive",
    "build:ios-internal:refresh": "eas build --platform ios --profile ios-internal --non-interactive --refresh-ad-hoc-provisioning-profile",
    "build:ios-testflight": "eas build --platform ios --profile ios-testflight --non-interactive",
    "build:ios-simulator-eas": "eas build --platform ios --profile ios-simulator --non-interactive",
    "submit:ios-testflight": "eas submit --platform ios --profile production --latest --non-interactive",
    "build": "tsc --noEmit && node -e \"const fs=require('fs');['App.tsx','app.json','src/offlineBoot.ts'].forEach((file)=>fs.accessSync(file)); console.log('mobile source ready')\"",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prepare:assets": "node scripts/prepareAssets.mjs",
    "test": "node --import tsx --test",
    "test:coverage": "node --import tsx --experimental-test-coverage --test"
  },
  "private": true,
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@types/react": "~19.1.0",
    "tsx": "4.20.6",
    "typescript": "~5.9.2"
  }
}
