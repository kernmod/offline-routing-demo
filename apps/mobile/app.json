{
  "expo": {
    "name": "Offline Routing Demo",
    "slug": "offline-routing-demo",
    "scheme": "offlineroutingdemo",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "dev.offlinerouting.demo",
      "intentFilters": [
        {
          "action": "VIEW",
