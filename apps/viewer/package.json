{
  "name": "@offline-routing/viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --dir ../.. build:wasm",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "mkdir -p .cache/coverage/.tmp && vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:base": "VITE_VIEWER_BASE=/viewer/ playwright test --project=desktop-chromium"
  },
  "dependencies": {
    "@offline-routing/route-studio": "workspace:*",
    "maplibre-gl": "^5.16.0",
    "pmtiles": "^4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
