{
  "name": "@offline-routing/route-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "scripts": {
    "build": "node --check index.js",
    "lint": "node --check index.js",
    "test": "node --test",
    "test:coverage": "c8 --check-coverage --lines 95 --functions 95 --branches 90 --reporter=text --reporter=lcov node --test"
  },
  "dependencies": {
    "@offline-routing/shared": "workspace:*"
  },
  "devDependencies": {
    "c8": "10.1.3"
  }
}
